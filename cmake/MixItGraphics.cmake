# Graphics (M6): FreeType for text rendering and the bundled default fonts.
#
# * FreeType 2.14.3 (FreeType License, BSD-style with credit; or GPLv2 — we
#   use the FTL), static, no optional dependencies (zlib/bzip2/png/brotli/
#   HarfBuzz off). Pinned to an exact commit; MIXIT_FREETYPE_DIR = offline
#   checkout.
# * DejaVu Sans / Sans Bold 2.37 (Bitstream Vera derived licence: free to
#   use, embed and redistribute), embedded into the engine as the default
#   title font. Pinned archive with SHA-256; MIXIT_DEJAVU_ZIP = offline copy.

option(MIXIT_ENABLE_GRAPHICS "Build the titles/graphics renderer (FreeType)" ON)
set(MIXIT_FREETYPE_DIR "" CACHE PATH "Local FreeType source tree (optional, offline builds)")
set(MIXIT_DEJAVU_ZIP "" CACHE FILEPATH "Local dejavu-fonts-ttf-2.37.zip (optional, offline builds)")

set(MIXIT_GRAPHICS_FOUND FALSE)
if(MIXIT_ENABLE_GRAPHICS)
    include(FetchContent)
    set(FT_DISABLE_ZLIB ON CACHE BOOL "" FORCE)
    set(FT_DISABLE_BZIP2 ON CACHE BOOL "" FORCE)
    set(FT_DISABLE_PNG ON CACHE BOOL "" FORCE)
    set(FT_DISABLE_HARFBUZZ ON CACHE BOOL "" FORCE)
    set(FT_DISABLE_BROTLI ON CACHE BOOL "" FORCE)
    set(SKIP_INSTALL_ALL ON CACHE BOOL "" FORCE)
    set(_saved_shared ${BUILD_SHARED_LIBS})
    set(BUILD_SHARED_LIBS OFF)
    set(_saved_pic ${CMAKE_POSITION_INDEPENDENT_CODE})
    set(CMAKE_POSITION_INDEPENDENT_CODE ON)
    if(MIXIT_FREETYPE_DIR)
        add_subdirectory(${MIXIT_FREETYPE_DIR} ${CMAKE_BINARY_DIR}/_deps/freetype-build EXCLUDE_FROM_ALL)
        set(_ft_src ${MIXIT_FREETYPE_DIR})
    else()
        FetchContent_Declare(freetype
            GIT_REPOSITORY https://github.com/freetype/freetype.git
            GIT_TAG 0a0221a1347e2f1e07c395263540026e9a0aa7c7  # VER-2-14-3
            GIT_SHALLOW FALSE
            EXCLUDE_FROM_ALL)
        FetchContent_MakeAvailable(freetype)
        set(_ft_src ${freetype_SOURCE_DIR})
    endif()
    set(BUILD_SHARED_LIBS ${_saved_shared})
    set(CMAKE_POSITION_INDEPENDENT_CODE ${_saved_pic})
    if(MSVC)
        target_compile_options(freetype PRIVATE /W0)
    else()
        target_compile_options(freetype PRIVATE -w)
    endif()

    # Default fonts, embedded as byte arrays.
    if(MIXIT_DEJAVU_ZIP)
        set(_dejavu_zip ${MIXIT_DEJAVU_ZIP})
    else()
        set(_dejavu_zip ${CMAKE_BINARY_DIR}/_deps/dejavu-fonts-ttf-2.37.zip)
        if(NOT EXISTS ${_dejavu_zip})
            file(DOWNLOAD
                https://github.com/dejavu-fonts/dejavu-fonts/releases/download/version_2_37/dejavu-fonts-ttf-2.37.zip
                ${_dejavu_zip}
                EXPECTED_HASH SHA256=7576310b219e04159d35ff61dd4a4ec4cdba4f35c00e002a136f00e96a908b0a
                TLS_VERIFY ON)
        endif()
    endif()
    file(SHA256 ${_dejavu_zip} _dejavu_hash)
    if(NOT _dejavu_hash STREQUAL "7576310b219e04159d35ff61dd4a4ec4cdba4f35c00e002a136f00e96a908b0a")
        message(FATAL_ERROR "DejaVu font archive hash mismatch: ${_dejavu_zip}")
    endif()
    set(_dejavu_dir ${CMAKE_BINARY_DIR}/_deps/dejavu)
    if(NOT EXISTS ${_dejavu_dir}/dejavu-fonts-ttf-2.37/ttf/DejaVuSans.ttf)
        file(ARCHIVE_EXTRACT INPUT ${_dejavu_zip} DESTINATION ${_dejavu_dir})
    endif()
    set(_font_cpp ${CMAKE_BINARY_DIR}/generated/mixit_default_fonts.cpp)
    if(NOT EXISTS ${_font_cpp})
        set(_out "// Generated by cmake/MixItGraphics.cmake: DejaVu Sans 2.37 (see THIRD_PARTY_LICENSES).\n#include <cstddef>\n#include <cstdint>\nnamespace mixit::graphics {\n")
        foreach(_pair "regular;DejaVuSans.ttf" "bold;DejaVuSans-Bold.ttf")
            list(GET _pair 0 _name)
            list(GET _pair 1 _file)
            file(READ ${_dejavu_dir}/dejavu-fonts-ttf-2.37/ttf/${_file} _hex HEX)
            string(LENGTH "${_hex}" _len)
            math(EXPR _bytes "${_len} / 2")
            string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _hex "${_hex}")
            string(REGEX REPLACE "((0x..,){32})" "\\1\n" _hex "${_hex}")
            string(APPEND _out "extern const std::uint8_t kFont_${_name}[${_bytes}] = {\n${_hex}};\nextern const std::size_t kFont_${_name}_size = ${_bytes};\n")
        endforeach()
        string(APPEND _out "}  // namespace mixit::graphics\n")
        file(WRITE ${_font_cpp} "${_out}")
    endif()
    set(MIXIT_FONT_SOURCES ${_font_cpp})
    set(MIXIT_DEJAVU_LICENSE_FILE ${_dejavu_dir}/dejavu-fonts-ttf-2.37/LICENSE)
    set(MIXIT_FREETYPE_LICENSE_FILE ${_ft_src}/LICENSE.TXT)
    install(FILES ${MIXIT_DEJAVU_LICENSE_FILE} DESTINATION share/licenses RENAME DEJAVU_FONTS_LICENSE.txt)
    install(FILES ${_ft_src}/docs/FTL.TXT DESTINATION share/licenses RENAME FREETYPE_LICENSE.txt OPTIONAL)
    set(MIXIT_GRAPHICS_FOUND TRUE)
endif()
message(STATUS "MIX IT: graphics (FreeType + DejaVu) ${MIXIT_GRAPHICS_FOUND}")
