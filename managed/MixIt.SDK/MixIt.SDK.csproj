<Project Sdk="Microsoft.NET.Sdk">
  <!--
    MixIt.SDK — interfaces for MIX IT extensions (EXPERIMENTAL). An extension is
    a .NET assembly that registers commands and listens to tally/command events.
    Depends only on MixIt.Protocol.
  -->
  <PropertyGroup>
    <RootNamespace>MixIt.SDK</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Self-describing members (enum values, factory helpers) are exempt. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MixIt.Protocol\MixIt.Protocol.csproj" />
  </ItemGroup>
</Project>
