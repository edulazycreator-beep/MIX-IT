<Project Sdk="Microsoft.NET.Sdk">
  <!-- Managed unit + integration tests. Loads the REAL native engine. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>MixIt.Tests</RootNamespace>
    <MixItCopyNativeEngine>true</MixItCopyNativeEngine>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\MixIt.Core\MixIt.Core.csproj" />
    <ProjectReference Include="..\..\MixIt.Remote\MixIt.Remote.csproj" />
    <ProjectReference Include="..\..\MixIt.Licensing\MixIt.Licensing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Lets tests find artefacts built next to the engine (e.g. the VST3 test plug-in). -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>MixItNativeDir</_Parameter1>
      <_Parameter2>$(MixItNativeDir)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
</Project>
