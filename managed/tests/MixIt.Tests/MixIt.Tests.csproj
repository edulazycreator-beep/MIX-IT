<Project Sdk="Microsoft.NET.Sdk">
  <!-- Managed unit + integration tests. Loads the REAL native engine. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>MixIt.Tests</RootNamespace>
    <MixItCopyNativeEngine>true</MixItCopyNativeEngine>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\MixIt.Core\MixIt.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
</Project>
