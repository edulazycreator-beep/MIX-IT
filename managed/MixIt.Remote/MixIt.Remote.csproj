<Project Sdk="Microsoft.NET.Sdk">
  <!--
    MixIt.Remote — the remote-control server (M7, ADR-0012): HTTP + WebSocket
    on Kestrel (ASP.NET Core shared framework), token authentication, the
    command layer of MixIt.Core. UI-free.
  -->
  <PropertyGroup>
    <RootNamespace>MixIt.Remote</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\MixIt.Core\MixIt.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="WebPanel.html" LogicalName="MixIt.Remote.WebPanel.html" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MixIt.Tests" />
  </ItemGroup>
</Project>
