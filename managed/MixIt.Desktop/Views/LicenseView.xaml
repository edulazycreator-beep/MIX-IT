<UserControl x:Class="MixIt.Desktop.Views.LicenseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- License Management. DataContext: LicenseViewModel. Bindings only. -->
    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
        <TextBlock Text="License" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
        <Border Style="{StaticResource PanelStyle}" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{Binding Edition}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Details}" Style="{StaticResource Value}" TextWrapping="Wrap" Margin="0,6,0,0" />
                <TextBlock Text="{Binding BuildNote}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Install licence file…" Command="{Binding InstallCommand}" Style="{StaticResource StudioButton}" />
                    <Button Content="Remove licence" Command="{Binding RemoveCommand}" Style="{StaticResource StudioButton}" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding Message}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource PanelStyle}" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="THIS PC" Style="{StaticResource Label}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBox Text="{Binding MachineId, Mode=OneWay}" IsReadOnly="True" Width="260" FontFamily="{StaticResource MonoFont}" />
                    <Button Content="Copy" Command="{Binding CopyMachineIdCommand}" Style="{StaticResource StudioButton}" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="Send this id when you buy a licence for one PC. It is an anonymous hash; no hardware details are sent anywhere. Licences are checked offline." />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource PanelStyle}" Padding="16">
            <StackPanel>
                <TextBlock Text="EDITIONS" Style="{StaticResource Label}" />
                <TextBlock Text="{Binding Limits}" Style="{StaticResource Value}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
