<UserControl x:Class="MixIt.Desktop.Views.ProductionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MixIt.Desktop.ViewModels">
    <!-- Production Studio: preview | program monitors, transition bar, input tiles.
         DataContext: ProductionViewModel. No logic here beyond bindings. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <DataTemplate x:Key="MonitorTemplate" DataType="{x:Type vm:BusMonitor}">
            <Grid>
                <Image Source="{Binding Bitmap}" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear" />
                <TextBlock Text="No signal — production stopped" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Bitmap}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="200" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: format and production start/stop -->
        <DockPanel Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <TextBlock Text="Format" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" Width="130" Margin="0,0,12,0"
                          IsEnabled="{Binding CanEditInputs}" VerticalAlignment="Center" />
                <CheckBox Content="GPU compositor (experimental)" IsChecked="{Binding UseGpuCompositor}"
                          IsEnabled="{Binding CanEditInputs}" Style="{StaticResource StudioCheckBox}"
                          ToolTip="Direct3D 11 compositing. Falls back to the CPU if the GPU is unavailable; the status line shows which one runs." />
                <Button Content="{Binding StartStopText}" Command="{Binding StartStopCommand}" Style="{StaticResource StudioButton}" Margin="0" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Production Studio" Style="{StaticResource SectionTitle}" Margin="0" />
                <TextBlock Text="Preview / program buses with transitions. Audio, recording and streaming are not available yet."
                           Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>

        <!-- Monitors -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" Foreground="{StaticResource PreviewBrush}" FontWeight="SemiBold">
                    <Run Text="PREVIEW" />
                    <Run Text="{Binding Preview.Source, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Normal" />
                </TextBlock>
                <Border Style="{StaticResource MonitorFrame}" BorderBrush="{StaticResource PreviewBrush}">
                    <ContentControl Content="{Binding Preview}" ContentTemplate="{StaticResource MonitorTemplate}" />
                </Border>
            </DockPanel>
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" Foreground="{StaticResource ProgramBrush}" FontWeight="SemiBold">
                    <Run Text="PROGRAM" />
                    <Run Text="{Binding Program.Source, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Normal" />
                </TextBlock>
                <Border Style="{StaticResource MonitorFrame}" BorderBrush="{StaticResource ProgramBrush}">
                    <ContentControl Content="{Binding Program}" ContentTemplate="{StaticResource MonitorTemplate}" />
                </Border>
            </DockPanel>
        </Grid>

        <!-- Transition bar -->
        <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Margin="0,12,0,0" Padding="12,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="CUT" Command="{Binding CutCommand}" Style="{StaticResource CutButton}" ToolTip="Swap preview and program now" />
                    <Button Content="AUTO" Command="{Binding AutoCommand}" Style="{StaticResource AutoButton}" ToolTip="Run the selected transition" />
                    <ComboBox ItemsSource="{Binding Transitions}" SelectedItem="{Binding SelectedTransition}" Width="90"
                              VerticalAlignment="Center" Margin="4,0,8,0" />
                    <TextBox Text="{Binding DurationFrames, UpdateSourceTrigger=LostFocus}" Width="48" VerticalAlignment="Center"
                             ToolTip="Transition duration in frames (1–600)" />
                    <TextBlock Text="frames" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="6,0,16,0" />
                    <TextBlock Text="PiP" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding PipChoices}" SelectedItem="{Binding SelectedPip}" Width="150" VerticalAlignment="Center"
                              ToolTip="Show an input as picture-in-picture on program" />
                </StackPanel>
                <ProgressBar Value="{Binding TransitionProgress, Mode=OneWay}" Maximum="1" Height="6" Margin="16,0,0,0"
                             VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" Background="{StaticResource PanelRaisedBrush}"
                             BorderThickness="0" Visibility="{Binding TransitionRunning, Converter={StaticResource BoolToVisibility}}" />
            </DockPanel>
        </Border>

        <!-- Errors are shown, never swallowed -->
        <Border Grid.Row="3" Margin="0,8,0,0" Padding="12,8" CornerRadius="4"
                Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
        </Border>

        <TextBlock Grid.Row="4" Text="{Binding Status}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,8"
                   FontFamily="{StaticResource MonoFont}" FontSize="11" TextTrimming="CharacterEllipsis" />

        <!-- Inputs: click = preview, double-click = straight to program -->
        <Border Grid.Row="5" Style="{StaticResource PanelStyle}" Padding="12">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="+ Test signal" Command="{Binding AddTestSignalCommand}" Style="{StaticResource StudioButton}" />
                        <Button Content="+ Media file…" Command="{Binding AddMediaFileCommand}" Style="{StaticResource StudioButton}" Margin="0" />
                    </StackPanel>
                    <TextBlock Text="Inputs" Style="{StaticResource Label}" FontSize="12" VerticalAlignment="Center" Margin="0" />
                    <TextBlock Text="  click: preview · double-click: program · stop production to add or remove inputs"
                               Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Inputs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:InputTileViewModel}">
                            <Border Width="170" Height="78" Margin="0,0,8,8" CornerRadius="4" BorderThickness="2" Padding="10,6"
                                    Background="{StaticResource PanelRaisedBrush}" Cursor="Hand">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OnPreview}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource PreviewBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding OnProgram}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource ProgramBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding SelectPreview}" />
                                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding TakeToProgram}" />
                                </Border.InputBindings>
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top">
                                        <Button DockPanel.Dock="Right" Content="✕" Padding="4,0" Margin="0" FontSize="10"
                                                Style="{StaticResource StudioButton}" ToolTip="Remove input"
                                                Command="{Binding Remove}" />
                                        <TextBlock Text="{Binding Number}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                    </DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis" Margin="0" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
