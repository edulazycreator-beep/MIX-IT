<UserControl x:Class="MixIt.Desktop.Views.ReplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Replay & Multiview. DataContext: ReplayViewModel. Bindings only. -->
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Replay &amp; Multiview" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />

        <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="12,8" CornerRadius="4"
                Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
        </Border>

        <!-- Replay inputs -->
        <Border DockPanel.Dock="Right" Width="460" Style="{StaticResource PanelStyle}" Padding="12" Margin="12,0,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="INSTANT REPLAY — video only, kept in memory" Style="{StaticResource Label}" Margin="0,0,0,8" />
                    <DockPanel>
                        <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" DisplayMemberPath="Title" Width="190"
                                  ToolTip="Input to record" />
                        <ComboBox ItemsSource="{Binding Lengths, Mode=OneTime}" SelectedItem="{Binding Seconds}" Width="70" Margin="6,0,0,0"
                                  ToolTip="Seconds kept (about 3 MB per second at 1080p)" ItemStringFormat="{}{0} s" />
                        <Button Content="+ Add replay" Command="{Binding AddReplayCommand}" Style="{StaticResource StudioButton}"
                                Margin="6,0,0,0" HorizontalAlignment="Left" ToolTip="Adds a replay input (stop production first)" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,8,0,8"
                               Text="MARK IN remembers the moment; PLAY MARK replays from it at the chosen speed. Put the replay on preview and take it like any input." />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelRaisedBrush}" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="✕" Command="{Binding RemoveCommand}" Style="{StaticResource StudioButton}"
                                                    ToolTip="Remove (stop production first)" />
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding Mark}" Style="{StaticResource Label}" Margin="0,2,0,6" />
                                        <WrapPanel>
                                            <Button Content="MARK IN" Command="{Binding MarkCommand}" Style="{StaticResource StudioButton}" Margin="0,0,4,4" />
                                            <Button Content="PLAY MARK" Command="{Binding PlayMarkCommand}" Style="{StaticResource StudioButton}" Margin="0,0,4,4" />
                                            <Button Content="LAST 5 s" Command="{Binding PlayLastCommand}" CommandParameter="5" Style="{StaticResource StudioButton}" Margin="0,0,4,4" />
                                            <Button Content="LAST 10 s" Command="{Binding PlayLastCommand}" CommandParameter="10" Style="{StaticResource StudioButton}" Margin="0,0,4,4" />
                                            <Button Content="{Binding PauseLabel}" Command="{Binding PauseCommand}" Style="{StaticResource StudioButton}" Margin="0,0,4,4" />
                                            <ComboBox ItemsSource="{Binding DataContext.Speeds, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneTime}"
                                                      SelectedItem="{Binding Speed}" DisplayMemberPath="Title" Width="80" Margin="0,0,4,4" ToolTip="Playback speed" />
                                            <Button Content="TO PREVIEW" Command="{Binding PreviewCommand}" Style="{StaticResource StudioButton}" Margin="0,0,4,4" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Multiview monitor -->
        <Border Style="{StaticResource PanelStyle}" Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="MULTIVIEW — preview, program and inputs 1-8 with tally (rendered only while shown or recorded)"
                           Style="{StaticResource Label}" Margin="0,0,0,6" />
                <Grid Background="Black">
                    <Image Source="{Binding Multiview.Bitmap}" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear" />
                    <TextBlock Text="Start production to see the multiview." HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Label}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Multiview.Bitmap}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
