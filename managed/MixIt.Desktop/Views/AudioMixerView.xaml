<UserControl x:Class="MixIt.Desktop.Views.AudioMixerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MixIt.Desktop.ViewModels">
    <!-- Audio Mixer. DataContext: AudioMixerViewModel. Bindings only. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="StripFrame" TargetType="Border">
            <Setter Property="Width" Value="112" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="Fader" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Minimum" Value="-60" />
            <Setter Property="Maximum" Value="12" />
            <Setter Property="Height" Value="170" />
            <Setter Property="SmallChange" Value="0.5" />
            <Setter Property="LargeChange" Value="6" />
            <Setter Property="TickFrequency" Value="6" />
            <Setter Property="TickPlacement" Value="TopLeft" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="ToolTip" Value="Fader (bottom = off)." />
        </Style>

        <!-- Detail editor rows: label, slider, value -->
        <Style x:Key="DetailSlider" TargetType="Slider">
            <Setter Property="Width" Value="150" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <TextBlock Text="Monitor / headphones" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding MonitorSources}" SelectedItem="{Binding MonitorSource}" Width="100"
                          ToolTip="Bus heard on the monitor when no strip is soloed" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Audio Mixer" Style="{StaticResource SectionTitle}" Margin="0" />
                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                           Text="Inputs are heard while they are on program (AFV) unless AFV is switched off. Solo affects the monitor only. Audio devices (output/capture) are not connected yet." />
            </StackPanel>
        </DockPanel>

        <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="12,8" CornerRadius="4"
                Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
        </Border>

        <!-- Detail editor for the selected strip -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource PanelStyle}" Padding="12" Margin="0,12,0,0"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
            <StackPanel DataContext="{Binding Selected}">
                <TextBlock Style="{StaticResource Label}" FontSize="12" Margin="0,0,0,8">
                    <Run Text="Processing —" />
                    <Run Text="{Binding Name, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" />
                </TextBlock>
                <WrapPanel>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="INPUT" Style="{StaticResource Label}" />
                        <DockPanel Margin="0,2">
                            <TextBlock Text="Trim" Width="70" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding TrimDb, StringFormat={}{0:+0.0;-0.0;0} dB}" Width="56" />
                            <Slider Value="{Binding TrimDb}" Minimum="-24" Maximum="24" Style="{StaticResource DetailSlider}" />
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="Delay" Width="70" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding DelayMs, StringFormat={}{0:0} ms}" Width="56" />
                            <Slider Value="{Binding DelayMs}" Minimum="0" Maximum="1000" SmallChange="1" LargeChange="20"
                                    Style="{StaticResource DetailSlider}" ToolTip="Lip-sync: delays this input's audio" />
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <CheckBox Content="High-pass" IsChecked="{Binding HighPass}" Width="70" Style="{StaticResource StudioCheckBox}" Margin="0" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding HighPassHz, StringFormat={}{0:0} Hz}" Width="56" />
                            <Slider Value="{Binding HighPassHz}" Minimum="20" Maximum="400" Style="{StaticResource DetailSlider}" />
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="Balance" Width="70" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Balance, StringFormat={}{0:+0.00;-0.00;0}}" Width="56" />
                            <Slider Value="{Binding Balance}" Minimum="-1" Maximum="1" SmallChange="0.05" Style="{StaticResource DetailSlider}" />
                        </DockPanel>
                    </StackPanel>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="EQ (dB)" Style="{StaticResource Label}" />
                        <DockPanel Margin="0,2">
                            <TextBlock Text="Low 100" Width="70" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding EqLowDb, StringFormat={}{0:+0.0;-0.0;0}}" Width="40" />
                            <Slider Value="{Binding EqLowDb}" Minimum="-15" Maximum="15" Style="{StaticResource DetailSlider}" />
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="Mid 500" Width="70" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding EqLowMidDb, StringFormat={}{0:+0.0;-0.0;0}}" Width="40" />
                            <Slider Value="{Binding EqLowMidDb}" Minimum="-15" Maximum="15" Style="{StaticResource DetailSlider}" />
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="Mid 2.5k" Width="70" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding EqHighMidDb, StringFormat={}{0:+0.0;-0.0;0}}" Width="40" />
                            <Slider Value="{Binding EqHighMidDb}" Minimum="-15" Maximum="15" Style="{StaticResource DetailSlider}" />
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="High 8k" Width="70" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding EqHighDb, StringFormat={}{0:+0.0;-0.0;0}}" Width="40" />
                            <Slider Value="{Binding EqHighDb}" Minimum="-15" Maximum="15" Style="{StaticResource DetailSlider}" />
                        </DockPanel>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="DYNAMICS" Style="{StaticResource Label}" />
                        <DockPanel Margin="0,2">
                            <CheckBox Content="Gate" IsChecked="{Binding GateEnabled}" Width="90" Style="{StaticResource StudioCheckBox}" Margin="0" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding GateThresholdDb, StringFormat={}{0:0} dB}" Width="56" />
                            <Slider Value="{Binding GateThresholdDb}" Minimum="-80" Maximum="0" Style="{StaticResource DetailSlider}" />
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <CheckBox Content="Compressor" IsChecked="{Binding CompressorEnabled}" Width="90" Style="{StaticResource StudioCheckBox}" Margin="0" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CompressorThresholdDb, StringFormat={}{0:0} dB}" Width="56" />
                            <Slider Value="{Binding CompressorThresholdDb}" Minimum="-60" Maximum="0" Style="{StaticResource DetailSlider}" />
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="Ratio" Width="90" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CompressorRatio, StringFormat={}{0:0.0}:1}" Width="56" />
                            <Slider Value="{Binding CompressorRatio}" Minimum="1" Maximum="20" Style="{StaticResource DetailSlider}" />
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="Make-up" Width="90" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CompressorMakeupDb, StringFormat={}{0:0.0} dB}" Width="56" />
                            <Slider Value="{Binding CompressorMakeupDb}" Minimum="0" Maximum="24" Style="{StaticResource DetailSlider}" />
                        </DockPanel>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Foreground="{StaticResource TextSecondaryBrush}"
                   Text="No inputs yet — add them in Production Studio.">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasInputs}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal">
                <!-- Input strips -->
                <ItemsControl ItemsSource="{Binding Strips}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StripViewModel}">
                            <Border Style="{StaticResource StripFrame}">
                                <StackPanel>
                                    <Button Command="{Binding SelectCommand}" Style="{StaticResource StudioButton}" Margin="0,0,0,6"
                                            Padding="4,2" ToolTip="Edit trim, delay, EQ and dynamics">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="88" />
                                    </Button>
                                    <WrapPanel HorizontalAlignment="Center">
                                        <ToggleButton Content="M" IsChecked="{Binding Mute}" Style="{StaticResource MuteToggle}" ToolTip="Mute" />
                                        <ToggleButton Content="S" IsChecked="{Binding Solo}" Style="{StaticResource SoloToggle}" ToolTip="Solo (monitor only)" />
                                        <ToggleButton Content="AFV" IsChecked="{Binding AudioFollowsVideo}" Style="{StaticResource StripToggle}"
                                                      ToolTip="Audio follows video: heard only while on program" />
                                    </WrapPanel>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Value="{Binding FaderDb}" Style="{StaticResource Fader}" HorizontalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <ProgressBar Value="{Binding PeakLeft, Mode=OneWay}" Style="{StaticResource MeterBar}" />
                                            <ProgressBar Value="{Binding PeakRight, Mode=OneWay}" Style="{StaticResource MeterBar}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding FaderText}" HorizontalAlignment="Center" FontFamily="{StaticResource MonoFont}" />
                                    <TextBlock Text="{Binding Reduction}" HorizontalAlignment="Center" FontSize="10"
                                               Foreground="{StaticResource WarningBrush}" TextTrimming="CharacterEllipsis" />
                                    <WrapPanel HorizontalAlignment="Center" Margin="0,4,0,0" ToolTip="Bus sends: Master, aux A..D">
                                        <ToggleButton Content="M" IsChecked="{Binding ToMaster}" Style="{StaticResource StripToggle}" ToolTip="Master" />
                                        <ToggleButton Content="A" IsChecked="{Binding ToA}" Style="{StaticResource StripToggle}" />
                                        <ToggleButton Content="B" IsChecked="{Binding ToB}" Style="{StaticResource StripToggle}" />
                                        <ToggleButton Content="C" IsChecked="{Binding ToC}" Style="{StaticResource StripToggle}" />
                                        <ToggleButton Content="D" IsChecked="{Binding ToD}" Style="{StaticResource StripToggle}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Rectangle Width="1" Fill="{StaticResource HairlineBrush}" Margin="6,0,12,0" />

                <!-- Buses -->
                <ItemsControl ItemsSource="{Binding Buses}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BusViewModel}">
                            <Border Style="{StaticResource StripFrame}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,8"
                                               Foreground="{StaticResource AccentBrush}" />
                                    <WrapPanel HorizontalAlignment="Center">
                                        <ToggleButton Content="M" IsChecked="{Binding Mute}" Style="{StaticResource MuteToggle}" ToolTip="Mute bus" />
                                        <ToggleButton Content="LIM" IsChecked="{Binding Limiter}" Style="{StaticResource StripToggle}"
                                                      ToolTip="Brick-wall limiter at -1 dBFS" />
                                    </WrapPanel>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Value="{Binding FaderDb}" Style="{StaticResource Fader}" HorizontalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <ProgressBar Value="{Binding PeakLeft, Mode=OneWay}" Style="{StaticResource MeterBar}" />
                                            <ProgressBar Value="{Binding PeakRight, Mode=OneWay}" Style="{StaticResource MeterBar}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding FaderText}" HorizontalAlignment="Center" FontFamily="{StaticResource MonoFont}" />
                                    <TextBlock Text="CLIP" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource ProgramBrush}"
                                               Visibility="{Binding Clip, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding Loudness}" FontSize="9" TextWrapping="Wrap" TextAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                    <Button Content="Reset I" Command="{Binding ResetLoudnessCommand}" Style="{StaticResource StudioButton}"
                                            Padding="4,1" Margin="0,4,0,0" FontSize="10" ToolTip="Restart integrated loudness" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Monitor (listen) -->
                <Border Style="{StaticResource StripFrame}" DataContext="{Binding MonitorBus}">
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,8"
                                   Foreground="{StaticResource WarningBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,32,0,0">
                            <ProgressBar Value="{Binding PeakLeft, Mode=OneWay}" Style="{StaticResource MeterBar}" />
                            <ProgressBar Value="{Binding PeakRight, Mode=OneWay}" Style="{StaticResource MeterBar}" />
                        </StackPanel>
                        <TextBlock Text="solo / listen" HorizontalAlignment="Center" FontSize="10" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
