<UserControl x:Class="MixIt.Desktop.Views.InputManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Input Manager. DataContext: InputManagerViewModel. Bindings only. -->
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Input Manager" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Input numbers are what shortcuts (D1…D9), macros and the remote API use. Renaming also changes the multiview label. Add inputs in Production Studio; remove only while production is stopped." />
        <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="4" Padding="10,8" Margin="0,0,0,6" BorderThickness="3,0,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OnPreview}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource PreviewBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OnProgram}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource ProgramBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Number}" FontSize="20" FontWeight="Bold" Width="40" VerticalAlignment="Center" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="PVW" Command="{Binding PreviewCommand}" Style="{StaticResource StudioButton}" Margin="0,0,4,0" />
                                    <Button Content="PGM" Command="{Binding ProgramCommand}" Style="{StaticResource StudioButton}" Margin="0,0,12,0" />
                                    <Button Content="Rename" Command="{Binding RenameCommand}" Style="{StaticResource StudioButton}" Margin="0,0,4,0" />
                                    <Button Content="Remove" Command="{Binding RemoveCommand}" Style="{StaticResource StudioButton}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxWidth="360" HorizontalAlignment="Left" MinWidth="240" />
                                    <TextBlock Style="{StaticResource Label}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0">
                                        <Run Text="{Binding Kind, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Detail, Mode=OneWay}" /><Run Text=" · id " /><Run Text="{Binding Id, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
