<UserControl x:Class="MixIt.Desktop.Views.ControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Automation & Control. DataContext: ControlViewModel. Bindings only. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Tab" Padding="14,7" Margin="0,0,4,0" CornerRadius="4,4,0,0" Background="{StaticResource PanelBrush}">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="{StaticResource PanelRaisedBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Automation &amp; Control" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />

        <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="12,8" CornerRadius="4"
                Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
        </Border>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Style="{StaticResource Label}" Margin="0,8,0,0" />

        <TabControl Background="{StaticResource PanelRaisedBrush}" BorderThickness="0" Padding="12">
            <!-- Macros -->
            <TabItem Header="Macros">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Width="220" Margin="0,0,12,0">
                        <ListBox ItemsSource="{Binding Macros}" SelectedItem="{Binding SelectedMacro}" DisplayMemberPath="Name" Height="300"
                                 Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="New" Command="{Binding NewMacroCommand}" Style="{StaticResource StudioButton}" Margin="0,0,4,4" />
                            <Button Content="▶ Run" Command="{Binding RunMacroCommand}" Style="{StaticResource StudioButton}" Margin="0,0,4,4" />
                            <Button Content="■ Stop all" Command="{Binding StopMacrosCommand}" Style="{StaticResource StudioButton}" Margin="0,0,4,4" />
                            <Button Content="Delete" Command="{Binding DeleteMacroCommand}" Style="{StaticResource StudioButton}" Margin="0,0,4,4" />
                        </WrapPanel>
                    </StackPanel>
                    <Expander DockPanel.Dock="Right" Header="Command reference" Width="320" Margin="12,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" IsExpanded="True">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
                            <ItemsControl ItemsSource="{Binding CommandReference}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Label}" TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding Parameters}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="10,0,0,0">
                                                            <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="= " /><Run Text="{Binding Description, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Expander>
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock Text="Name" Style="{StaticResource Label}" VerticalAlignment="Center" Width="50" />
                            <CheckBox DockPanel.Dock="Right" Content="Stop at the first error" IsChecked="{Binding StopOnError}" Style="{StaticResource StudioCheckBox}" Margin="8,0,0,0" />
                            <Button DockPanel.Dock="Right" Content="Save" Command="{Binding SaveMacroCommand}" Style="{StaticResource StudioButton}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding MacroName, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="One command per line: Command key=value key=&quot;text with spaces&quot;. Wait 500 pauses 500 ms. # starts a comment. Inputs: number, id:N or name." />
                        <TextBox Text="{Binding MacroText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                                 FontFamily="{StaticResource MonoFont}" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" MinHeight="260" />
                    </DockPanel>
                </DockPanel>
            </TabItem>

            <!-- Automation rules -->
            <TabItem Header="Automation">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="10,8" CornerRadius="4" Background="{StaticResource PanelBrush}" Margin="0,0,0,10">
                        <DockPanel>
                            <CheckBox Content="ARMED — rules may run macros" IsChecked="{Binding Armed}" Style="{StaticResource StudioCheckBox}" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Label}" Margin="16,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Text="Nothing runs unattended until you arm automation. Times that pass while disarmed are not caught up." />
                        </DockPanel>
                    </Border>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox Text="{Binding RuleName, UpdateSourceTrigger=PropertyChanged}" Width="150" ToolTip="Rule name" />
                        <ComboBox ItemsSource="{Binding Triggers}" SelectedItem="{Binding RuleTrigger}" Width="150" Margin="6,0,0,0" />
                        <TextBox Text="{Binding RuleWhen, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="6,0,0,0"
                                 ToolTip="Daily: 19:00 · Once: 2026-12-24 18:30 · Interval: seconds · start/stop: ignored" />
                        <ComboBox ItemsSource="{Binding MacroNames}" SelectedItem="{Binding RuleMacro}" Width="160" Margin="6,0,0,0" ToolTip="Macro to run" />
                        <Button Content="+ Add rule" Command="{Binding AddRuleCommand}" Style="{StaticResource StudioButton}" Margin="6,0,0,0" />
                        <Button Content="Remove" Command="{Binding RemoveRuleCommand}" Style="{StaticResource StudioButton}" Margin="6,0,0,0" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" Background="{StaticResource PanelBrush}" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="{StaticResource TextPrimaryBrush}">
                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  →  " /><Run Text="{Binding Macro, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- Remote control -->
            <TabItem Header="Remote control">
                <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="HTTP + WebSocket API (docs/REMOTE_API.md) and a browser control page. Every request needs the token. Allow the network only on a trusted LAN." />
                    <CheckBox Content="Enable remote control" IsChecked="{Binding RemoteEnabled}" Style="{StaticResource StudioCheckBox}" />
                    <CheckBox Content="Allow other computers on the network (otherwise this PC only)" IsChecked="{Binding RemoteNetwork}" Style="{StaticResource StudioCheckBox}" Margin="0,6,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Port" Style="{StaticResource Label}" VerticalAlignment="Center" Width="50" />
                        <TextBox Text="{Binding RemotePort, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                        <Button Content="Apply" Command="{Binding ApplyRemoteCommand}" Style="{StaticResource StudioButton}" Margin="8,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Token" Style="{StaticResource Label}" VerticalAlignment="Center" Width="50" />
                        <TextBox Text="{Binding Token, Mode=OneWay}" IsReadOnly="True" Width="380" FontFamily="{StaticResource MonoFont}" />
                        <CheckBox Content="show" IsChecked="{Binding TokenVisible}" Style="{StaticResource StudioCheckBox}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        <Button Content="Copy" Command="{Binding CopyTokenCommand}" Style="{StaticResource StudioButton}" Margin="8,0,0,0" />
                        <Button Content="New token" Command="{Binding NewTokenCommand}" Style="{StaticResource StudioButton}" Margin="4,0,0,0"
                                ToolTip="Clients using the old token are refused afterwards" />
                    </StackPanel>
                    <TextBlock Text="{Binding RemoteState}" Style="{StaticResource Value}" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </TabItem>

            <!-- Tally -->
            <TabItem Header="Tally">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding TallySummary}" Style="{StaticResource Value}" Margin="0,0,0,10" FontFamily="{StaticResource MonoFont}" />
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="TSL UMD v5.0 over UDP to tally controllers and multiviewers (experimental: no tally hardware tested). Display index = input number. Also on the remote API." />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox Text="{Binding TallyHost, UpdateSourceTrigger=PropertyChanged}" Width="180" ToolTip="Host or IP" />
                        <TextBox Text="{Binding TallyPort, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="6,0,0,0" ToolTip="UDP port" />
                        <TextBox Text="{Binding TallyScreen, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="6,0,0,0" ToolTip="TSL screen" />
                        <Button Content="+ Add" Command="{Binding AddTallyCommand}" Style="{StaticResource StudioButton}" Margin="6,0,0,0" />
                        <Button Content="Remove" Command="{Binding RemoveTallyCommand}" Style="{StaticResource StudioButton}" Margin="6,0,0,0" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding TallyDestinations}" SelectedItem="{Binding SelectedTally}" Background="{StaticResource PanelBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                </DockPanel>
            </TabItem>

            <!-- PTZ -->
            <TabItem Header="PTZ cameras">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="VISCA over IP (experimental: no camera tested). Sony cameras: UDP 52381; PTZOptics and others: raw UDP 1259 or TCP 5678." />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox Text="{Binding CameraName, UpdateSourceTrigger=PropertyChanged}" Width="120" ToolTip="Name" />
                        <TextBox Text="{Binding CameraHost, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="6,0,0,0" ToolTip="Host or IP" />
                        <ComboBox ItemsSource="{Binding Transports}" SelectedItem="{Binding CameraTransport}" Width="100" Margin="6,0,0,0" />
                        <TextBox Text="{Binding CameraPort, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="6,0,0,0" ToolTip="Port" />
                        <Button Content="+ Add" Command="{Binding AddCameraCommand}" Style="{StaticResource StudioButton}" Margin="6,0,0,0" />
                        <Button Content="Remove" Command="{Binding RemoveCameraCommand}" Style="{StaticResource StudioButton}" Margin="6,0,0,0" />
                    </StackPanel>
                    <ListBox DockPanel.Dock="Left" Width="240" ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera}"
                             Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                    <StackPanel Margin="16,0,0,0">
                        <TextBlock Text="PRESETS" Style="{StaticResource Label}" />
                        <ItemsControl ItemsSource="{Binding Presets}" Margin="0,4,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" Width="44" Margin="0,0,4,4" Style="{StaticResource StudioButton}"
                                            Command="{Binding DataContext.PtzPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <CheckBox Content="Store (next preset button saves the position)" IsChecked="{Binding StorePresets}" Style="{StaticResource StudioCheckBox}" />
                        <TextBlock Text="MOVE (press, then STOP)" Style="{StaticResource Label}" Margin="0,12,0,4" />
                        <UniformGrid Columns="3" Width="160" HorizontalAlignment="Left">
                            <Button Content="↖" Command="{Binding PtzMoveCommand}" CommandParameter="upleft" Style="{StaticResource StudioButton}" Margin="2" />
                            <Button Content="↑" Command="{Binding PtzMoveCommand}" CommandParameter="up" Style="{StaticResource StudioButton}" Margin="2" />
                            <Button Content="↗" Command="{Binding PtzMoveCommand}" CommandParameter="upright" Style="{StaticResource StudioButton}" Margin="2" />
                            <Button Content="←" Command="{Binding PtzMoveCommand}" CommandParameter="left" Style="{StaticResource StudioButton}" Margin="2" />
                            <Button Content="■" Command="{Binding PtzStopCommand}" Style="{StaticResource StudioButton}" Margin="2" ToolTip="Stop" />
                            <Button Content="→" Command="{Binding PtzMoveCommand}" CommandParameter="right" Style="{StaticResource StudioButton}" Margin="2" />
                            <Button Content="↙" Command="{Binding PtzMoveCommand}" CommandParameter="downleft" Style="{StaticResource StudioButton}" Margin="2" />
                            <Button Content="↓" Command="{Binding PtzMoveCommand}" CommandParameter="down" Style="{StaticResource StudioButton}" Margin="2" />
                            <Button Content="↘" Command="{Binding PtzMoveCommand}" CommandParameter="downright" Style="{StaticResource StudioButton}" Margin="2" />
                        </UniformGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Zoom +" Command="{Binding PtzZoomCommand}" CommandParameter="in" Style="{StaticResource StudioButton}" />
                            <Button Content="Zoom −" Command="{Binding PtzZoomCommand}" CommandParameter="out" Style="{StaticResource StudioButton}" Margin="4,0,0,0" />
                            <Button Content="Zoom stop" Command="{Binding PtzZoomCommand}" CommandParameter="stop" Style="{StaticResource StudioButton}" Margin="4,0,0,0" />
                            <Button Content="Home" Command="{Binding PtzHomeCommand}" Style="{StaticResource StudioButton}" Margin="12,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </TabItem>

            <!-- Extensions -->
            <TabItem Header="Extensions">
                <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Extensions are .NET assemblies built against MixIt.SDK (experimental). They run inside MIX IT with your rights: install only extensions you trust. Each goes in its own folder: Extensions\Name\Name.dll." />
                    <CheckBox Content="Load extensions at start" IsChecked="{Binding ExtensionsEnabled}" Style="{StaticResource StudioCheckBox}" />
                    <TextBlock Text="{Binding ExtensionsFolder}" Style="{StaticResource Value}" Margin="0,6,0,10" FontFamily="{StaticResource MonoFont}" />
                    <ItemsControl ItemsSource="{Binding Extensions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" TextWrapping="Wrap">
                                    <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Error, Mode=OneWay, TargetNullValue=loaded}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
