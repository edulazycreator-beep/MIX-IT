<UserControl x:Class="MixIt.Desktop.Views.GraphicsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Graphics Studio. DataContext: GraphicsViewModel. Bindings only. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Graphics Studio" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />

        <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="12,8" CornerRadius="4"
                Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
        </Border>

        <!-- Overlay channels -->
        <Border DockPanel.Dock="Top" Style="{StaticResource PanelStyle}" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="OVERLAY CHANNELS — on top of the program, kept across cuts" Style="{StaticResource Label}" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Channels}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="{Binding Title}" Width="80" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{Binding Inputs}" SelectedItem="{Binding Input}" DisplayMemberPath="Title" Width="200"
                                          ToolTip="Graphics, a logo, or a camera (with a key: virtual set)" />
                                <ComboBox ItemsSource="{Binding Keys}" SelectedItem="{Binding Key}" DisplayMemberPath="Title" Width="140" Margin="6,0,0,0" />
                                <TextBlock Text="fade" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="10,0,4,0" />
                                <TextBox Text="{Binding FadeFrames, UpdateSourceTrigger=LostFocus}" Width="44" ToolTip="Fade length in frames (0 = cut)" />
                                <Button Content="IN" Command="{Binding InCommand}" Style="{StaticResource StudioButton}" Margin="8,0,0,0" />
                                <Button Content="OUT" Command="{Binding OutCommand}" Style="{StaticResource StudioButton}" Margin="4,0,0,0" />
                                <Button Content="CUT" Command="{Binding CutCommand}" Style="{StaticResource StudioButton}" Margin="4,0,0,0"
                                        ToolTip="Toggle without fade" />
                                <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="3" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding OnAir}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource ProgramBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding State}" />
                                </Border>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- New graphics -->
        <Border DockPanel.Dock="Left" Width="320" Style="{StaticResource PanelStyle}" Padding="12" Margin="0,0,12,0" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="NEW GRAPHICS" Style="{StaticResource Label}" Margin="0,0,0,8" />
                <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding Template}" DisplayMemberPath="Name" />
                <Button Content="+ Add title" Command="{Binding AddTemplateCommand}" Style="{StaticResource StudioButton}"
                        HorizontalAlignment="Left" Margin="0,6,0,12" ToolTip="Adds a graphics input (stop production first)" />
                <TextBlock Text="Logo (PNG / JPG file)" Style="{StaticResource Label}" />
                <TextBox Text="{Binding LogoPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0" />
                <Button Content="+ Add logo" Command="{Binding AddLogoCommand}" Style="{StaticResource StudioButton}"
                        HorizontalAlignment="Left" Margin="0,6,0,0" />
                <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,12,0,0"
                           Text="Graphics are inputs: put them on an overlay channel (above) and take them IN/OUT. Field edits go on air as you type." />
            </StackPanel>
        </Border>

        <!-- Graphics inputs with live fields -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource PanelStyle}" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Warnings}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" MaxWidth="300" />
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Fields}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Name}" Width="110" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Timer" Style="{StaticResource Label}" Width="110" VerticalAlignment="Center" />
                                    <ComboBox ItemsSource="{Binding TimerModes}" SelectedItem="{Binding TimerMode}" Width="110" />
                                    <TextBox Text="{Binding TimerSeconds, UpdateSourceTrigger=LostFocus}" Width="60" Margin="6,0,0,0" ToolTip="Countdown start, seconds" />
                                    <Button Content="Start" Command="{Binding StartTimerCommand}" Style="{StaticResource StudioButton}" Margin="6,0,0,0" />
                                    <Button Content="Pause" Command="{Binding PauseTimerCommand}" Style="{StaticResource StudioButton}" Margin="4,0,0,0" />
                                    <Button Content="Reset" Command="{Binding ResetTimerCommand}" Style="{StaticResource StudioButton}" Margin="4,0,0,0" />
                                    <TextBlock Text="{Binding TimerText}" Style="{StaticResource Value}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
