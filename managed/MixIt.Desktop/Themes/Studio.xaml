<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        MIX IT "Studio" theme — the single source of colours, type and spacing.
        Views reference these keys only; no hard-coded colours in views.
        Signal colours follow broadcast convention: red = program/on-air,
        green = preview/healthy, amber = warning/degraded.
    -->
    <Color x:Key="CanvasColor">#0E1014</Color>
    <Color x:Key="PanelColor">#161920</Color>
    <Color x:Key="PanelRaisedColor">#1E222B</Color>
    <Color x:Key="HairlineColor">#2A2F3A</Color>
    <Color x:Key="TextPrimaryColor">#E8EAF0</Color>
    <Color x:Key="TextSecondaryColor">#8D94A5</Color>
    <Color x:Key="AccentColor">#4F8CFF</Color>
    <Color x:Key="ProgramColor">#E5484D</Color>
    <Color x:Key="PreviewColor">#30A46C</Color>
    <Color x:Key="WarningColor">#F5A524</Color>

    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="PanelRaisedBrush" Color="{StaticResource PanelRaisedColor}" />
    <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource HairlineColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="ProgramBrush" Color="{StaticResource ProgramColor}" />
    <SolidColorBrush x:Key="PreviewBrush" Color="{StaticResource PreviewColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <Thickness x:Key="PanelPadding">16</Thickness>
    <CornerRadius x:Key="PanelRadius">6</CornerRadius>

    <Style x:Key="WindowStyle" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="PanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PanelRadius}" />
        <Setter Property="Padding" Value="{StaticResource PanelPadding}" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,0,12,6" />
    </Style>

    <Style x:Key="Value" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="StudioButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Transition controls: CUT carries the program colour, AUTO the accent. -->
    <Style x:Key="CutButton" TargetType="Button" BasedOn="{StaticResource StudioButton}">
        <Setter Property="Background" Value="{StaticResource ProgramBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ProgramBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Padding" Value="18,10" />
    </Style>

    <Style x:Key="AutoButton" TargetType="Button" BasedOn="{StaticResource StudioButton}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Padding" Value="18,10" />
    </Style>

    <Style x:Key="StudioCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,12,0" />
    </Style>

    <!-- Audio meter: a ProgressBar (Minimum -60, Maximum 0 dBFS) drawn
         vertically. The template is laid out horizontally and rotated, which is
         how ProgressBar sizes its PART_Indicator. -->
    <LinearGradientBrush x:Key="MeterGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2FBF71" Offset="0.0" />
        <GradientStop Color="#2FBF71" Offset="0.70" />
        <GradientStop Color="#E3C341" Offset="0.85" />
        <GradientStop Color="#E5484D" Offset="1.0" />
    </LinearGradientBrush>

    <Style x:Key="MeterBar" TargetType="ProgressBar">
        <Setter Property="Minimum" Value="-60" />
        <Setter Property="Maximum" Value="0" />
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="170" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid Background="#11151B">
                        <Grid.LayoutTransform>
                            <RotateTransform Angle="-90" />
                        </Grid.LayoutTransform>
                        <Border x:Name="PART_Track" />
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{StaticResource MeterGradient}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small latching buttons on strips (M, S, AFV, bus sends). -->
    <Style x:Key="StripToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MuteToggle" TargetType="ToggleButton" BasedOn="{StaticResource StripToggle}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource ProgramBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SoloToggle" TargetType="ToggleButton" BasedOn="{StaticResource StripToggle}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource WarningBrush}" />
                <Setter Property="Foreground" Value="Black" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Bus monitor frame: black picture area, tally-coloured border. -->
    <Style x:Key="MonitorFrame" TargetType="Border">
        <Setter Property="Background" Value="Black" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>

    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}" BorderThickness="3,0,0,0" BorderBrush="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource PanelRaisedBrush}" />
                            <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
