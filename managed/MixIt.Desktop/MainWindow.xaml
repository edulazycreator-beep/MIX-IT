<Window x:Class="MixIt.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MixIt.Desktop.ViewModels"
        xmlns:views="clr-namespace:MixIt.Desktop.Views"
        Title="{Binding WindowTitle}" Width="1280" Height="800" MinWidth="960" MinHeight="600"
        Style="{StaticResource WindowStyle}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <DockPanel>
        <!-- Header: product identity + engine status -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource HairlineBrush}"
                BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MIX" FontWeight="Bold" FontSize="18" />
                    <TextBlock Text=" IT" FontWeight="Light" FontSize="18" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="  Live Production Studio" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding Settings.ShowName, StringFormat='   ·   {0}'}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                </StackPanel>
                <Border HorizontalAlignment="Right" CornerRadius="10" Padding="10,3" Background="{StaticResource PanelRaisedBrush}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EngineHealthy}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource PreviewBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding EngineStatus}" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Production dashboard: values from the engine, refreshed every second -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource HairlineBrush}"
                BorderThickness="0,1,0,0" Padding="16,5" DataContext="{Binding StatusBar}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Resources}" Foreground="{StaticResource TextSecondaryBrush}" Margin="16,0,0,0" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding Control}" Foreground="{StaticResource TextSecondaryBrush}" Margin="16,0,0,0" />
                <TextBlock Text="{Binding Clock}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" Margin="0,0,16,0" />
                <TextBlock Text="{Binding OnAir}" FontWeight="SemiBold" Margin="0,0,16,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOnAir}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ProgramBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Outputs}" FontWeight="SemiBold" Margin="0,0,16,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource ProgramBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OutputWarning}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Timing}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TimingWarning}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Section navigation: every entry states its real status -->
        <Border DockPanel.Dock="Left" Width="230" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,1,0">
            <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}"
                     Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
                     Margin="0,8,0,0">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SectionItem}">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" />
                            <TextBlock Text="{Binding Status}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Margin="16">
            <!-- Placeholder for sections without a backend: states it plainly -->
            <Border VerticalAlignment="Top">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource PanelStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowPlaceholder}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding SelectedSection.Title}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Value}"
                               Text="{Binding SelectedSection.Status, StringFormat='{}{0}. This section has no implementation yet; nothing here controls the engine.'}" />
                </StackPanel>
            </Border>

            <views:ProductionView DataContext="{Binding Production}"
                                  Visibility="{Binding DataContext.ShowProduction, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />

            <views:AudioMixerView DataContext="{Binding AudioMixer}"
                                  Visibility="{Binding DataContext.ShowAudioMixer, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />

            <views:GraphicsView DataContext="{Binding Graphics}"
                                Visibility="{Binding DataContext.ShowGraphics, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />

            <views:ReplayView DataContext="{Binding Replay}"
                              Visibility="{Binding DataContext.ShowReplay, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />

            <views:ControlView DataContext="{Binding Control}"
                               Visibility="{Binding DataContext.ShowControl, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />

            <views:LicenseView DataContext="{Binding License}"
                               Visibility="{Binding DataContext.ShowLicense, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />

            <views:InputManagerView DataContext="{Binding InputManager}"
                                    Visibility="{Binding DataContext.ShowInputManager, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />

            <views:SettingsView DataContext="{Binding Settings}"
                                Visibility="{Binding DataContext.ShowSettings, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />

            <views:OutputsView DataContext="{Binding Outputs}"
                               Visibility="{Binding DataContext.ShowOutputs, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />

            <ContentControl Content="{Binding Diagnostics}"
                            Visibility="{Binding ShowDiagnostics, Converter={StaticResource BoolToVisibility}}">
                <ContentControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button Content="Detect hardware" Command="{Binding DetectCommand}" Style="{StaticResource StudioButton}" />
                                    <Button Content="Restart engine" Command="{Binding RestartCommand}" Style="{StaticResource StudioButton}" Margin="0" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Hardware Diagnostics" Style="{StaticResource SectionTitle}" Margin="0" />
                                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>

                            <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,12" Padding="12,8" CornerRadius="4"
                                    Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource ProgramBrush}" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
                            </Border>

                            <Border Grid.Row="2" Style="{StaticResource PanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="System" Style="{StaticResource Label}" FontSize="12" />
                                    <ItemsControl ItemsSource="{Binding SystemRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:InfoRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Value}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="GPU adapters" Style="{StaticResource Label}" FontSize="12" Margin="0,12,0,6" />
                                    <ItemsControl ItemsSource="{Binding Gpus}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:InfoRow}">
                                                <StackPanel Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Value}" Margin="0" />
                                                    <TextBlock Text="{Binding Value}" Style="{StaticResource Label}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource PanelStyle}" Padding="0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Engine log" Style="{StaticResource Label}" FontSize="12" Margin="16,12,16,6" />
                                    <ListView ItemsSource="{Binding Log}" Background="Transparent" BorderThickness="0"
                                              Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                        <ListView.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:LogRow}">
                                                <TextBlock TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="{Binding Time, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <Run Text="{Binding Category, Mode=OneWay, StringFormat=' [{0}] '}" />
                                                    <Run Text="{Binding Message, Mode=OneWay}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Grid>
    </DockPanel>
</Window>
